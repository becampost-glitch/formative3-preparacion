*.tfstate.*

# Archivos de variables con contraseñas o credenciales
*.tfvars
*.tfvars.json

# Archivos de respaldo y logs
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
